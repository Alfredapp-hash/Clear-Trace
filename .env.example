# ClearTrace environment. Copy to .env (Docker Compose) or .env.local (npm run dev).
# Generate every secret below with:   openssl rand -base64 48
# Leave a secret empty only for local development; production refuses weak/missing values
# once the production config guards are in place.

# --- Required in production ---------------------------------------------------
# Session signing secret.
SESSION_SECRET=
# AES-256 key for encrypted identity claims. Changing it makes stored claims unreadable.
ENCRYPTION_KEY=
# Bearer token for POST /api/worker/run and /api/cron/* (used by the compose worker-cron).
WORKER_SECRET=

# --- Optional -----------------------------------------------------------------
# Alternate bearer token accepted by /api/cron/* for external schedulers.
CRON_SECRET=

# SQLite database path (default: ./data/cleartrace.db; Docker image uses /app/data/cleartrace.db).
DATABASE_URL=./data/cleartrace.db

# Public app URL for links and Stripe checkout redirects. Also accepted as a same-origin
# Origin for API writes, so set it to the public URL when a reverse proxy rewrites Host.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Who may self-register:
#   first_user (default) - sign-up is open only until the first account exists, then closes.
#   invite               - sign-up is always closed. There is no invite flow yet, so this
#                          simply locks registration.
#   open                 - anyone who can reach the app may register (e2e / CI use this).
REGISTRATION_MODE=first_user

# Network binding (Docker Compose): the app is published on 127.0.0.1:3000, reachable from
# this machine only. To use it from your LAN or via a reverse proxy on another host, opt in by
# editing the port mapping in docker-compose.yml ("3000:3000" or "<lan-ip>:3000:3000") and set
# NEXT_PUBLIC_APP_URL (and FORCE_HTTPS / TRUST_PROXY) to match. A reverse proxy on the same
# host can keep the loopback binding and proxy to 127.0.0.1:3000.

# Inline background jobs from dashboard loads (scheduled after the response, at most once per
# 5 minutes) instead of a scheduler:
#   1     = always schedule the inline fallback
#   0     = never (rely on worker-cron or another scheduler)
#   empty = only when WORKER_SECRET is unset
# Leave empty (or 0) when the compose worker-cron (or another scheduler) calls /api/worker/run.
INLINE_WORKER=

# Set to 1 to show Settings -> Developer (Skill registry, Sentinel) to every signed-in user
# and allow them to run the Sentinel release gate. Without it, Developer is shown to
# organization owners/admins, and running the gate needs a developer/admin account role.
DEVELOPER_MODE=

# Set to 1 only when ClearTrace is served over HTTPS (adds upgrade-insecure-requests + HSTS).
# Leave empty for plain-HTTP LAN self-hosting.
FORCE_HTTPS=

# Set to 1 only behind a reverse proxy you control that sets X-Forwarded-For;
# otherwise client-supplied forwarding headers are ignored (e.g. for rate limiting).
# With TRUST_PROXY=1 the login lockout is per email + client IP.
TRUST_PROXY=

# Comma-separated Ollama origins treated as local (exact origin match).
# Docker: Ollama on the host is reachable at http://host.docker.internal:11434.
OLLAMA_ALLOWED_ORIGINS=http://localhost:11434,http://127.0.0.1:11434,http://host.docker.internal:11434

# Comma-separated SMTP hosts (exact hostnames or IP literals) allowed to resolve to private-LAN
# addresses (10/8, 172.16/12, 192.168/16, 100.64/10, fc00::/7), e.g. a Postfix relay on your
# network. All other SMTP hosts must resolve to public IPs. Loopback, link-local and cloud
# metadata addresses (e.g. 169.254.169.254) are always refused, even when listed here.
SMTP_ALLOWED_HOSTS=

# --- Optional Stripe billing — when unset, all Pro features are enabled (self-hosted)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# Apple Intelligence bridge (apple-bridge/): exact local origins allowed for the
# "Apple Intelligence (on-device)" connector. Default covers 127.0.0.1/localhost/
# host.docker.internal on port 11435.
APPLE_BRIDGE_ALLOWED_ORIGINS=

# --- Backups, restore and logging (v1.4.0) -------------------------------------
# Passphrase for encrypted backups (scripts/backup.mjs; AES-256-GCM, key = scrypt(passphrase)).
# Generate with `openssl rand -base64 48`. Store it — and ENCRYPTION_KEY — away from the
# backups: a backup cannot be read without BACKUP_PASSPHRASE, and its identity claims cannot
# be read without ENCRYPTION_KEY. See docs/self-hosting/backup-restore.md.
BACKUP_PASSPHRASE=
# How many cleartrace-<ISO>.db.enc backups to keep in <data>/backups.
BACKUP_KEEP=7
# Days to keep pre-migrate-* / pre-restore-* snapshots in <data>/backups (default 30). They
# are full database copies, so they still hold cases erased after they were taken; the worker
# and each backup run delete older ones. With BACKUP_PASSPHRASE set they are written encrypted.
BACKUP_SNAPSHOT_RETENTION_DAYS=30
# Structured JSON logs: debug | info (default) | warn | error | silent.
LOG_LEVEL=info
# Health URL scripts/restore.mjs probes (never starts) to make sure the app is stopped.
CLEARTRACE_URL=http://127.0.0.1:3000/api/health
