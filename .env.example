# Session signing secret (required in production)
SESSION_SECRET=change-me-to-a-long-random-string

# AES-256 encryption key for identity claims (required in production)
ENCRYPTION_KEY=change-me-to-a-long-random-string

# SQLite database path (default: ./data/cleartrace.db)
DATABASE_URL=./data/cleartrace.db

# Bearer token for POST /api/worker/run and /api/cron/verify (required in production)
WORKER_SECRET=

# Public app URL for Stripe checkout redirects (default: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Stripe billing — when unset, all Pro features are enabled (self-hosted)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=