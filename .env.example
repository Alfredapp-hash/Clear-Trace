# ClearTrace environment. Copy to .env (Docker Compose) or .env.local (npm run dev).
# Generate every secret below with:   openssl rand -base64 48
# Leave a secret empty only for local development; production refuses weak/missing values
# once the production config guards are in place.

# --- Required in production ---------------------------------------------------
# Session signing secret.
SESSION_SECRET=
# AES-256 key for encrypted identity claims. Changing it makes stored claims unreadable.
ENCRYPTION_KEY=
# Bearer token for POST /api/worker/run and /api/cron/* (used by the compose worker-cron).
WORKER_SECRET=

# --- Optional -----------------------------------------------------------------
# Alternate bearer token accepted by /api/cron/* for external schedulers.
CRON_SECRET=

# SQLite database path (default: ./data/cleartrace.db; Docker image uses /app/data/cleartrace.db).
DATABASE_URL=./data/cleartrace.db

# Public app URL for links and Stripe checkout redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to 1 only when ClearTrace is served over HTTPS (adds upgrade-insecure-requests + HSTS).
# Leave empty for plain-HTTP LAN self-hosting.
FORCE_HTTPS=

# Set to 1 only behind a reverse proxy you control that sets X-Forwarded-For;
# otherwise client-supplied forwarding headers are ignored (e.g. for rate limiting).
TRUST_PROXY=

# Comma-separated Ollama origins treated as local (exact origin match).
# Docker: Ollama on the host is reachable at http://host.docker.internal:11434.
OLLAMA_ALLOWED_ORIGINS=http://localhost:11434,http://127.0.0.1:11434,http://host.docker.internal:11434

# Comma-separated SMTP hosts (exact hostnames or IP literals) allowed to resolve to private-LAN
# addresses (10/8, 172.16/12, 192.168/16, 100.64/10, fc00::/7), e.g. a Postfix relay on your
# network. All other SMTP hosts must resolve to public IPs. Loopback, link-local and cloud
# metadata addresses (e.g. 169.254.169.254) are always refused, even when listed here.
SMTP_ALLOWED_HOSTS=

# --- Optional Stripe billing — when unset, all Pro features are enabled (self-hosted)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# Apple Intelligence bridge (apple-bridge/): exact local origins allowed for the
# "Apple Intelligence (on-device)" connector. Default covers 127.0.0.1/localhost/
# host.docker.internal on port 11435.
APPLE_BRIDGE_ALLOWED_ORIGINS=
